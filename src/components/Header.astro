---
import { site } from '../content/site';
const base = import.meta.env.BASE_URL;
---
<header class="site-header">
  <div class="container inner">
    <a class="brand" href={base}>{site.name}</a>
    <nav aria-label="Navegación principal">
      <a href={`${base}actividad/`}>Actividad</a>
      <a href={`${base}actividad/#contacto`}>Contacto</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    border-bottom: 1px solid rgba(79, 169, 209, .2);
    background: rgba(3, 8, 13, .9);
    backdrop-filter: blur(16px);
    box-shadow: 0 12px 40px rgba(0, 0, 0, .16);
  }
  .inner {
    min-height: 76px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .brand {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 700;
    letter-spacing: .02em;
    color: var(--color-cream);
    text-decoration: none;
  }
  nav {
    display: flex;
    gap: 1.35rem;
    flex-wrap: wrap;
    justify-content: flex-end;
  }
  nav a {
    position: relative;
    font-size: .95rem;
    font-weight: 600;
    color: var(--color-muted);
    text-decoration: none;
  }
  nav a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 100%;
    bottom: -.35rem;
    height: 1px;
    background: var(--color-water);
    transition: right .18s ease;
  }
  nav a:hover { color: var(--color-cream); }
  nav a:hover::after { right: 0; }
  .brand:hover { color: var(--color-water-bright); }
</style>
