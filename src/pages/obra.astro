---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../content/site';
import { bookSchema, faqSchema } from '../core/schema';
const book = site.featuredBook;

const metadata = [
  ['Autor', site.name],
  ['Género', book.genre],
  ['Año', book.year],
  ['Páginas', book.pages],
  ['ISBN', book.isbn],
  ['Edición', book.publisher],
].filter(([, value]) => Boolean(value));
---
<BaseLayout
  title={`${book.title} | ${site.name}`}
  description={book.synopsis}
  schema={[bookSchema(), faqSchema()]}
>
  <section class="section book-page">
    <div class="water-orbit orbit-one"></div>
    <div class="water-orbit orbit-two"></div>
    <div class="container book-grid">
      <div class="cover-wrap">
        <div class="cover-glow"></div>
        <img
          src={book.cover}
          alt={`Portada de ${book.title}`}
          width="520"
          height="780"
        />
      </div>
      <article>
        <p class="eyebrow">Libro</p>
        <h1 class="enigma-title">{book.title}</h1>
        <p class="subtitle">{book.subtitle}</p>
        <p class="lead">{book.synopsis}</p>

        {metadata.length > 0 && (
          <dl>
            {metadata.map(([label, value]) => (
              <div><dt>{label}</dt><dd>{value}</dd></div>
            ))}
          </dl>
        )}

        {book.buyUrl && (
          <div class="purchase">
            <p class="purchase-label">Disponible online</p>
            <a
              class="button"
              href={book.buyUrl}
              target="_blank"
              rel="noopener"
            >
              {book.buyLabel || 'Comprar el libro'}
            </a>
          </div>
        )}
      </article>
    </div>
  </section>

  <section class="section faq">
    <div class="container faq-inner">
      <p class="eyebrow">Preguntas frecuentes</p>
      <h2>Sobre el autor y la obra</h2>
      <div class="faq-grid">
        {site.faq.map((item) => (
          <article class="card">
            <h3>{item.question}</h3>
            <p>{item.answer}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .book-page {
    min-height: 72vh;
    display: grid;
    align-items: center;
    background:
      radial-gradient(circle at 20% 48%, rgba(79,169,209,.16), transparent 28rem),
      linear-gradient(180deg, rgba(3,8,13,.3), rgba(6,19,28,.65));
  }
  .book-grid {
    display: grid;
    gap: clamp(3rem, 7vw, 7rem);
    align-items: center;
  }
  .cover-wrap {
    position: relative;
    display: flex;
    justify-content: center;
  }
  .cover-glow {
    position: absolute;
    inset: 12% 10%;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(79,169,209,.3), transparent 68%);
    filter: blur(18px);
  }
  img {
    position: relative;
    z-index: 2;
    width: min(100%, 370px);
    max-height: 570px;
    object-fit: cover;
    border-radius: 10px;
    box-shadow: var(--shadow), var(--water-shadow);
    border: 1px solid rgba(158,220,243,.32);
  }
  article { max-width: 680px; }
  .enigma-title {
    font-family: var(--font-accent);
    font-size: clamp(4.8rem, 8vw, 7.5rem);
    line-height: .82;
  }
  .subtitle {
    margin: 1rem 0 1.3rem;
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 2.3vw, 1.9rem);
    color: var(--color-cream);
  }
  .subtitle::after {
    content: '';
    display: block;
    width: 78px;
    height: 2px;
    margin-top: 1rem;
    background: var(--color-accent);
  }
  .purchase {
    margin-top: 2rem;
    padding-top: 1.4rem;
    border-top: 1px solid rgba(79,169,209,.2);
  }
  .purchase-label {
    margin-bottom: .8rem;
    font-size: .82rem;
    font-weight: 700;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--color-water-bright);
  }
  dl { margin: 2rem 0; }
  dl div {
    display: grid;
    grid-template-columns: 100px 1fr;
    gap: 1rem;
    padding: .65rem 0;
    border-bottom: 1px solid rgba(79,169,209,.2);
  }
  dt { font-weight: 700; color: var(--color-cream); }
  dd { margin: 0; color: var(--color-muted); }
  .faq {
    background: rgba(8,25,35,.64);
    border-top: 1px solid rgba(79,169,209,.2);
  }
  .faq-inner { max-width: 1000px; }
  .faq-grid {
    display: grid;
    gap: 1.2rem;
    margin-top: 2rem;
  }
  .water-orbit {
    position: absolute;
    border: 1px solid rgba(79,169,209,.15);
    border-radius: 50%;
    pointer-events: none;
  }
  .orbit-one {
    width: 620px;
    height: 250px;
    left: -160px;
    top: 20%;
    transform: rotate(-18deg);
  }
  .orbit-two {
    width: 520px;
    height: 200px;
    right: -140px;
    bottom: 10%;
    transform: rotate(20deg);
  }
  @media (min-width: 860px) {
    .book-grid { grid-template-columns: .85fr 1.15fr; }
    .faq-grid { grid-template-columns: repeat(2, 1fr); }
  }
</style>
