---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../content/site';
import { bookSchema, faqSchema } from '../core/schema';
const book = site.featuredBook;

const metadata = [
  ['Autor', site.name],
  ['Género', book.genre],
  ['Año', book.year],
  ['Páginas', book.pages],
  ['ISBN', book.isbn],
  ['Edición', book.publisher],
].filter(([, value]) => Boolean(value));
---
<BaseLayout
  title={`${book.title} | ${site.name}`}
  description={book.synopsis}
  schema={[bookSchema(), faqSchema()]}
>
  <section class="section book-page">
    <div class="container book-grid">
      <div class="cover-wrap">
        <img
          src={book.cover}
          alt={`Portada de ${book.title}`}
          width="520"
          height="780"
        />
      </div>
      <article>
        <p class="eyebrow">Libro</p>
        <h1>{book.title}</h1>
        <p class="subtitle">{book.subtitle}</p>
        <p class="lead">{book.synopsis}</p>

        {metadata.length > 0 && (
          <dl>
            {metadata.map(([label, value]) => (
              <div><dt>{label}</dt><dd>{value}</dd></div>
            ))}
          </dl>
        )}

        {book.buyUrl && <a class="button" href={book.buyUrl}>Dónde conseguirlo</a>}
      </article>
    </div>
  </section>

  <section class="section faq">
    <div class="container faq-inner">
      <p class="eyebrow">Preguntas frecuentes</p>
      <h2>Sobre el autor y la obra</h2>
      <div class="faq-grid">
        {site.faq.map((item) => (
          <article class="card">
            <h3>{item.question}</h3>
            <p>{item.answer}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .book-page { min-height: 72vh; display: grid; align-items: center; }
  .book-grid {
    display: grid;
    gap: clamp(3rem, 7vw, 7rem);
    align-items: center;
  }
  .cover-wrap {
    display: flex;
    justify-content: center;
  }
  img {
    width: min(100%, 360px);
    max-height: 560px;
    object-fit: cover;
    border-radius: 10px;
    box-shadow: var(--shadow);
    border: 1px solid var(--color-border);
  }
  article { max-width: 680px; }
  .subtitle {
    margin: .8rem 0 1.2rem;
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2.2vw, 1.75rem);
    color: var(--color-accent);
  }
  dl { margin: 2rem 0; }
  dl div {
    display: grid;
    grid-template-columns: 100px 1fr;
    gap: 1rem;
    padding: .65rem 0;
    border-bottom: 1px solid var(--color-border);
  }
  dt { font-weight: 700; }
  dd { margin: 0; color: var(--color-muted); }
  .faq {
    background: var(--color-surface);
    border-top: 1px solid var(--color-border);
  }
  .faq-inner { max-width: 1000px; }
  .faq-grid {
    display: grid;
    gap: 1.2rem;
    margin-top: 2rem;
  }
  @media (min-width: 860px) {
    .book-grid { grid-template-columns: .85fr 1.15fr; }
    .faq-grid { grid-template-columns: repeat(2, 1fr); }
  }
</style>
