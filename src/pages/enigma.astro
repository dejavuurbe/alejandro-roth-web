---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../content/site';

const whatsappUrl = 'https://wa.me/541154149673?text=Hola%20Alejandro%2C%20quiero%20pedir%20el%20libro%20f%C3%ADsico%20de%20Enigma.%20%C2%BFMe%20indic%C3%A1s%20el%20precio%20y%20las%20opciones%20de%20entrega%3F';
const hotmartUrl = site.featuredBook.hotmartCheckoutUrl;
const isHotmartUrl = /^https:\/\/pay\.hotmart\.com\//.test(hotmartUrl);
---
<BaseLayout
  title="Enigma en libro físico o digital | Alejandro Roth"
  description="Pedí el libro físico de Enigma por WhatsApp o comprá la edición digital en Hotmart."
>
  <section class="section order-page">
    <div class="container order-grid">
      <div class="book-side">
        <div class="book-glow"></div>
        <img
          class="cover"
          src={site.featuredBook.cover}
          alt={`Portada de ${site.featuredBook.fullTitle}`}
          width="1103"
          height="1536"
        />
      </div>

      <div class="order-copy">
        <p class="eyebrow">Gracias por llegar hasta acá</p>
        <h1>Elegí cómo leer <span>Enigma</span>.</h1>

        <p class="lead">
          Para pedir el <strong>libro físico</strong>, consultá el precio y coordiná la entrega con Alejandro por WhatsApp.
          Para comprar el <strong>libro digital (eBook)</strong>, accedé al pago en Hotmart.
        </p>

        <a class="button whatsapp-button" href={whatsappUrl} target="_blank" rel="noopener noreferrer">
          Pedir libro físico por WhatsApp
        </a>

        {isHotmartUrl ? (
          <a class="button digital-button" href={hotmartUrl} target="_blank" rel="noopener noreferrer">
            Comprar libro digital
          </a>
        ) : (
          <span class="button digital-button digital-preview" aria-disabled="true">
            Comprar libro digital
          </span>
        )}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .order-page {
    min-height: var(--section-full);
    display: grid;
    align-items: center;
    padding-block: var(--section-full-pad-y);
    background:
      radial-gradient(circle at 24% 48%, rgba(79,169,209,.16), transparent 25rem),
      linear-gradient(180deg, #06131c, #03080d);
  }

  .order-grid {
    display: grid;
    align-items: center;
    gap: clamp(3rem, 8vw, 7rem);
  }

  .book-side {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 520px;
  }

  .book-glow {
    position: absolute;
    width: 430px;
    height: 430px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(79,169,209,.28), transparent 68%);
    filter: blur(10px);
  }

  .cover {
    position: relative;
    z-index: 2;
    width: min(100%, 390px);
    max-height: min(540px, calc(100svh - var(--header-height) - 7rem));
    height: auto;
    object-fit: contain;
    border-radius: 10px;
    border: 1px solid rgba(158,220,243,.28);
    box-shadow: 0 28px 70px rgba(0,0,0,.55), 0 0 45px rgba(79,169,209,.12);
    transition: transform .22s ease, box-shadow .22s ease, border-color .22s ease;
  }

  .cover:hover {
    transform: translateY(-8px) scale(1.025);
    box-shadow: 0 34px 85px rgba(0,0,0,.62), 0 0 58px rgba(79,169,209,.2);
    border-color: rgba(158,220,243,.5);
  }

  .order-copy {
    max-width: 620px;
  }

  .order-copy h1 {
    font-size: clamp(3rem, 5vw, 5.25rem);
    line-height: .95;
    margin-bottom: 1.2rem;
  }

  .order-copy h1 span {
    font-family: var(--font-accent);
    color: var(--color-cream);
  }

  .order-copy .lead {
    max-width: 40ch;
    line-height: 1.5;
    margin-bottom: 1rem;
  }

  .incoherente-hover {
    display: inline-block;
    transform-origin: center;
    transition: transform .2s ease, text-shadow .2s ease, color .2s ease;
  }

  .incoherente-hover:hover {
    transform: translateY(-2px) scale(1.09);
    color: var(--color-accent);
    text-shadow: 0 0 16px rgba(216,52,42,.42);
  }

  .whatsapp-button {
    min-height: 54px;
    padding-inline: 1.5rem;
    font-size: 1rem;
  }

  .digital-button {
    margin-top: .9rem;
  }

  .digital-preview {
    opacity: .72;
    cursor: default;
  }

  @media (min-width: 900px) {
    .order-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 899px) {
    .order-page {
      min-height: auto;
      display: block;
      padding-block: 3.5rem;
    }

    .book-side {
      min-height: auto;
      margin-bottom: 2.5rem;
    }

    .cover {
      max-height: 520px;
    }
  }
</style>
