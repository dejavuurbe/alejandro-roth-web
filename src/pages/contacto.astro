---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../content/site';
---
<BaseLayout
  title={`Contacto | ${site.name}`}
  description={`Canales públicos de ${site.name}.`}
>
  <section class="section contact-page">
    <div class="container contact-card">
      <div>
        <p class="eyebrow">Contacto</p>
        <h1>Canales públicos</h1>
        <p class="lead">
          Para conocer novedades, presentaciones y actividad pública de Alejandro Roth,
          consulta sus canales oficiales disponibles.
        </p>
      </div>

      <div class="contact-links">
        {site.social.filter((item) => item.url).map((item) => (
          <a class="button secondary" href={item.url} target="_blank" rel="me noopener">
            {item.label}
          </a>
        ))}
        {site.email && <a class="button" href={`mailto:${site.email}`}>{site.email}</a>}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-page {
    min-height: 72vh;
    display: grid;
    align-items: center;
    background:
      radial-gradient(circle at 82% 36%, rgba(79,169,209,.14), transparent 26rem);
  }
  .contact-card {
    position: relative;
    overflow: hidden;
    max-width: 980px;
    padding: clamp(2.2rem, 5vw, 4.5rem);
    border: 1px solid rgba(79,169,209,.3);
    border-radius: var(--radius);
    background:
      linear-gradient(145deg, rgba(255,255,255,.025), transparent 55%),
      rgba(8,25,35,.82);
    box-shadow: var(--shadow), var(--water-shadow);
  }
  .contact-card::after {
    content: '';
    position: absolute;
    width: 420px;
    height: 160px;
    right: -100px;
    bottom: -70px;
    border-radius: 50%;
    border: 1px solid rgba(158,220,243,.28);
    transform: rotate(-16deg);
  }
  .contact-links {
    position: relative;
    z-index: 2;
    display: flex;
    gap: .9rem;
    flex-wrap: wrap;
    margin-top: 2.2rem;
  }
</style>
