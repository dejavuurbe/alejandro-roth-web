---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../content/site';
---
<BaseLayout
  title={`Contacto | ${site.name}`}
  description={`Canales públicos de ${site.name}.`}
>
  <section class="section">
    <div class="container">
      <p class="eyebrow">Contacto</p>
      <h1>Canales públicos</h1>
      <p class="lead">
        Esta web es una prueba. Por el momento utilizamos únicamente los canales públicos
        localizados durante el diagnóstico digital.
      </p>

      <div class="contact-links">
        {site.social.filter((item) => item.url).map((item) => (
          <a class="button" href={item.url} target="_blank" rel="me noopener">
            {item.label}
          </a>
        ))}
        {site.email && <a class="button" href={`mailto:${site.email}`}>{site.email}</a>}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-links {
    display: flex;
    gap: .8rem;
    flex-wrap: wrap;
    margin-top: 2rem;
  }
</style>
