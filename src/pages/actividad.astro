---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../content/site';
import SocialIcon from '../components/SocialIcon.astro';
---
<BaseLayout
  title="Alejandro Roth, escritor argentino de Rafael Castillo | Actividad"
  description="Recorrido público y fuente documentada de Alejandro Roth, escritor argentino de Rafael Castillo y autor de Enigma: Relato de un amor incoherente."
>
  <section class="section stories-page" id="relatos">
    <div class="container stories-inner">
      <p class="eyebrow">Muestra de escritura</p>
      <h1>Relatos cortos</h1>
      <article class="story-card">
        <div>
          <p class="story-kicker">Relato</p>
          <h2>El Flaco Facundo: “Un Frío Feriante”</h2>
          <p class="story-excerpt">
            En 1971 nació el sexto hijo de un matrimonio pobre. Lo llamaron Facundo.
            Creció entre el basural, el trabajo, la violencia y la promesa siempre postergada
            de construir una vida distinta.
          </p>
        </div>
        <a class="button secondary" href={`${import.meta.env.BASE_URL}relatos/el-flaco-facundo/`}>
          Leer relato
        </a>
      </article>
    </div>
  </section>

  <section class="section activity-page">
    <div class="container activity-inner">
      <div class="activity-head">
        <div>
          <p class="eyebrow">Actividad literaria</p>
          <h1>Presentaciones y recorrido público</h1>
        </div>
        <p class="lead">
          Tres referencias del recorrido público de Alejandro Roth y su primera novela en el oeste del Gran Buenos Aires.
        </p>
      </div>

      <div class="press-grid">
        {site.press.map((item, index) => (
          <article class="card activity-card">
            <span class="drop" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            <p class="eyebrow">{item.source}</p>
            <h2>{item.title}</h2>
            <p>{item.description}</p>
            {item.url && (
              <a class="source-link" href={item.url} target="_blank" rel="noopener noreferrer">
                <SocialIcon label="Instagram" /> Ver fuente de la actividad →
              </a>
            )}
          </article>
        ))}
      </div>

      <p class="additional-activity">
        También confirmados para incorporar: {site.additionalActivity.join(' · ')}. La documentación específica está pendiente de sumar.
      </p>
    </div>
  </section>

  <section class="contact-page" id="contacto">
    <div class="container contact-compact">
      <div class="contact-title">
        <p class="eyebrow">Contacto</p>
        <h2>Alejandro Roth</h2>
      </div>

      <div class="contact-links">
        <a href={site.contact.instagramUrl} target="_blank" rel="noopener noreferrer">
          Instagram <span>{site.contact.instagramHandle}</span>
        </a>
        <a href={site.contact.facebookUrl} target="_blank" rel="noopener noreferrer">
          Facebook
        </a>
        <a href={`mailto:${site.contact.email}`}>
          Correo <span>{site.contact.email}</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .stories-page {
    min-height: var(--section-full);
    display: grid;
    align-items: center;
    padding-block: var(--section-full-pad-y);
    border-bottom: 1px solid rgba(79,169,209,.2);
    background:
      radial-gradient(circle at 20% 35%, rgba(79,169,209,.12), transparent 24rem),
      linear-gradient(180deg, #041018, #06131c);
  }

  .stories-inner {
    max-width: 1120px;
  }

  .stories-page h1 {
    margin-bottom: 1.4rem;
    font-size: clamp(3rem, 5vw, 5rem);
  }

  .story-card {
    min-height: clamp(280px, 42vh, 430px);
    display: grid;
    gap: 2rem;
    align-items: end;
    padding: clamp(1.6rem, 4vw, 3rem);
    border: 1px solid rgba(79,169,209,.28);
    border-radius: var(--radius);
    background:
      linear-gradient(145deg, rgba(255,255,255,.025), transparent 55%),
      rgba(8,25,35,.58);
  }

  .story-card h2 {
    max-width: 18ch;
    margin-bottom: 1rem;
    font-size: clamp(2rem, 3.5vw, 3.5rem);
  }

  .story-kicker {
    margin: 0 0 .45rem;
    color: var(--color-water-bright);
    font-size: .78rem;
    font-weight: 700;
    letter-spacing: .14em;
    text-transform: uppercase;
  }

  .story-excerpt {
    max-width: 56ch;
    margin: 0;
    color: var(--color-muted);
    font-size: clamp(1rem, 1.3vw, 1.14rem);
    line-height: 1.6;
  }

  .story-card .button {
    width: fit-content;
  }

  .activity-page {
    min-height: var(--section-full);
    display: grid;
    align-items: center;
    padding-block: var(--section-full-pad-y);
    background:
      radial-gradient(circle at 75% 18%, rgba(79,169,209,.11), transparent 25rem);
  }

  .activity-inner { max-width: 1120px; }

  .activity-head {
    display: grid;
    gap: 1.2rem;
    align-items: end;
  }

  .activity-page h1 {
    max-width: 18ch;
    font-size: clamp(3.1rem, 4.7vw, 4.9rem);
    line-height: .98;
  }

  .activity-head .lead {
    max-width: 38ch;
    margin: 0;
  }

  .lead { max-width: 55ch; }

  .press-grid {
    display: grid;
    gap: 1.1rem;
    margin-top: 1.6rem;
    max-width: 1120px;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
  }

  .activity-card {
    position: relative;
    overflow: hidden;
    padding: clamp(1rem, 1.45vw, 1.35rem);
  }

  .activity-card > p:not(.eyebrow) {
    margin-bottom: .6rem;
    line-height: 1.55;
  }

  .activity-card::after {
    content: '';
    position: absolute;
    width: 220px;
    height: 95px;
    right: -80px;
    bottom: -50px;
    border-radius: 50%;
    border: 1px solid rgba(79,169,209,.24);
    transform: rotate(-14deg);
  }

  .drop {
    display: inline-block;
    margin-bottom: .85rem;
    font-family: var(--font-accent);
    font-size: 1.9rem;
    color: var(--color-accent);
  }

  .press-grid h2 {
    font-size: clamp(1.55rem, 2vw, 2rem);
    margin-bottom: .65rem;
  }

  .source-link {
    display: inline-flex;
    align-items: center;
    gap: .45rem;
    margin-top: .65rem;
    color: var(--color-cream);
    font-weight: 700;
    text-decoration: none;
    border-bottom: 1px solid var(--color-accent);
  }

  .contact-page {
    border-top: 1px solid rgba(79,169,209,.2);
    background: rgba(3,8,13,.72);
  }

  .contact-compact {
    display: grid;
    gap: 1.4rem 3rem;
    align-items: center;
    padding-block: 1.5rem 1.7rem;
  }

  .contact-title .eyebrow {
    margin-bottom: .2rem;
  }

  .contact-title h2 {
    margin: 0;
    font-size: clamp(1.55rem, 2.1vw, 2.15rem);
  }

  .contact-links {
    display: flex;
    flex-wrap: wrap;
    gap: .75rem 1.5rem;
    align-items: center;
  }

  .contact-links a {
    color: var(--color-cream);
    text-decoration: none;
    font-weight: 700;
    border-bottom: 1px solid rgba(216,52,42,.7);
    padding-bottom: .15rem;
  }

  .contact-links a:hover {
    color: var(--color-water-bright);
  }

  .contact-links span {
    margin-left: .35rem;
    color: var(--color-muted);
    font-weight: 500;
  }

  .additional-activity {
    margin: 1rem 0 0;
    color: var(--color-muted);
    font-size: .92rem;
  }

  @media (max-width: 640px) {
    .contact-links {
      display: grid;
      gap: .65rem;
    }

    .contact-links a {
      width: fit-content;
      overflow-wrap: anywhere;
    }

    .contact-links span {
      display: block;
      margin: .15rem 0 0;
    }
  }

  @media (min-width: 920px) {
    .activity-head {
      grid-template-columns: 1.15fr .85fr;
    }

    .contact-compact {
      grid-template-columns: .65fr 1.35fr;
    }
  }

  @media (max-width: 919px) {
    .activity-page {
      min-height: auto;
      display: block;
      padding-block: clamp(3rem, 8vw, 5rem);
    }
  }
</style>
