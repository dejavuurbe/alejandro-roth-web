---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../content/site';
import SocialIcon from '../components/SocialIcon.astro';
---
<BaseLayout
  title="Alejandro Roth, escritor argentino de Rafael Castillo | Actividad"
  description="Recorrido público y fuente documentada de Alejandro Roth, escritor argentino de Rafael Castillo y autor de Enigma: Relato de un amor incoherente."
>
  <section class="section activity-page">
    <div class="container activity-inner">
      <div class="activity-head">
        <div>
          <p class="eyebrow">Actividad literaria</p>
          <h1>Presentaciones y recorrido público</h1>
        </div>
        <p class="lead">
          Tres referencias del recorrido público de Alejandro Roth y su primera novela en el oeste del Gran Buenos Aires.
        </p>
      </div>

      <div class="press-grid">
        {site.press.map((item, index) => (
          <article class="card activity-card">
            <span class="drop" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            <p class="eyebrow">{item.source}</p>
            <h2>{item.title}</h2>
            <p>{item.description}</p>
            {item.url && (
              <a class="source-link" href={item.url} target="_blank" rel="noopener noreferrer">
                <SocialIcon label="Instagram" /> Ver fuente de la actividad →
              </a>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section contact-page" id="contacto">
    <div class="container contact-card">
      <div>
        <p class="eyebrow">Contacto</p>
        <h2>Canal público por confirmar</h2>
        <p class="lead">
          El canal de contacto público está pendiente de confirmación por parte del autor. Se incorporará aquí cuando Alejandro indique qué dato desea publicar.
        </p>
        <p class="contact-label">Correo de contacto · ejemplo de maquetación</p>
        <a class="contact-email" href="mailto:aleroth@web.com.ar">aleroth@web.com.ar</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .activity-page {
    min-height: var(--section-full);
    display: grid;
    align-items: center;
    padding-block: var(--section-full-pad-y);
    background:
      radial-gradient(circle at 75% 18%, rgba(79,169,209,.11), transparent 25rem);
  }

  .activity-inner { max-width: 1120px; }

  .activity-head {
    display: grid;
    gap: 1.2rem;
    align-items: end;
  }

  .activity-page h1 {
    max-width: 18ch;
    font-size: clamp(3.1rem, 4.7vw, 4.9rem);
    line-height: .98;
  }

  .activity-head .lead {
    max-width: 38ch;
    margin: 0;
  }

  .lead { max-width: 55ch; }

  .press-grid {
    display: grid;
    gap: 1.1rem;
    margin-top: 1.6rem;
    max-width: 1120px;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
  }

  .activity-card {
    position: relative;
    overflow: hidden;
    padding: clamp(1rem, 1.45vw, 1.35rem);
  }

  .activity-card > p:not(.eyebrow) {
    margin-bottom: .6rem;
    line-height: 1.55;
  }

  .activity-card::after {
    content: '';
    position: absolute;
    width: 220px;
    height: 95px;
    right: -80px;
    bottom: -50px;
    border-radius: 50%;
    border: 1px solid rgba(79,169,209,.24);
    transform: rotate(-14deg);
  }

  .drop {
    display: inline-block;
    margin-bottom: .85rem;
    font-family: var(--font-accent);
    font-size: 1.9rem;
    color: var(--color-accent);
  }

  .press-grid h2 {
    font-size: clamp(1.55rem, 2vw, 2rem);
    margin-bottom: .65rem;
  }

  .source-link {
    display: inline-flex;
    align-items: center;
    gap: .45rem;
    margin-top: .65rem;
    color: var(--color-cream);
    font-weight: 700;
    text-decoration: none;
    border-bottom: 1px solid var(--color-accent);
  }

  .contact-page {
    display: grid;
    align-items: center;
    border-top: 1px solid rgba(79,169,209,.2);
    background:
      radial-gradient(circle at 82% 36%, rgba(79,169,209,.14), transparent 26rem);
  }

  .contact-card {
    position: relative;
    overflow: hidden;
    max-width: 980px;
    padding: clamp(2.2rem, 5vw, 4.5rem);
    border: 1px solid rgba(79,169,209,.3);
    border-radius: var(--radius);
    background:
      linear-gradient(145deg, rgba(255,255,255,.025), transparent 55%),
      rgba(8,25,35,.82);
    box-shadow: var(--shadow), var(--water-shadow);
  }

  .contact-card::after {
    content: '';
    position: absolute;
    width: 420px;
    height: 160px;
    right: -100px;
    bottom: -70px;
    border-radius: 50%;
    border: 1px solid rgba(158,220,243,.28);
    transform: rotate(-16deg);
  }

  .contact-label {
    margin: 1.5rem 0 .3rem;
    font-size: .76rem;
    font-weight: 700;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--color-water-bright);
  }

  .contact-email {
    position: relative;
    z-index: 2;
    display: inline-block;
    color: var(--color-cream);
    font-family: var(--font-display);
    font-size: clamp(1.7rem, 3vw, 2.5rem);
    line-height: 1.1;
    text-decoration: none;
    border-bottom: 1px solid var(--color-accent);
  }

  .contact-email:hover {
    color: var(--color-water-bright);
  }

  @media (min-width: 920px) {
    .activity-head {
      grid-template-columns: 1.15fr .85fr;
    }

  }

  @media (max-width: 919px) {
    .activity-page {
      min-height: auto;
      display: block;
      padding-block: clamp(3rem, 8vw, 5rem);
    }
  }
</style>
