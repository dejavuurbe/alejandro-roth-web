---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../content/site';
---
<BaseLayout
  title={`Actividad literaria | ${site.name}`}
  description={`Presentaciones y actividad cultural de ${site.name}.`}
>
  <section class="section activity-page">
    <div class="container activity-inner">
      <p class="eyebrow">Actividad literaria</p>
      <h1>Presentaciones y recorrido público</h1>
      <p class="lead">
        Registro de espacios y actividades vinculadas con Alejandro Roth y su obra.
      </p>
      <div class="press-grid">
        {site.press.map((item, index) => (
          <article class="card activity-card">
            <span class="drop" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            <p class="eyebrow">{item.source}</p>
            <h2>{item.title}</h2>
            <p>{item.description}</p>
            {item.url && <a class="source-link" href={item.url} target="_blank" rel="noopener">Ver fuente →</a>}
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .activity-page {
    min-height: 72vh;
    background:
      radial-gradient(circle at 75% 18%, rgba(79,169,209,.11), transparent 25rem);
  }
  .activity-inner { max-width: 1120px; }
  h1 { max-width: 13ch; }
  .lead { max-width: 55ch; }
  .press-grid {
    display: grid;
    gap: 1.25rem;
    margin-top: 3rem;
  }
  .activity-card {
    position: relative;
    overflow: hidden;
  }
  .activity-card::after {
    content: '';
    position: absolute;
    width: 220px;
    height: 95px;
    right: -80px;
    bottom: -50px;
    border-radius: 50%;
    border: 1px solid rgba(79,169,209,.24);
    transform: rotate(-14deg);
  }
  .drop {
    display: inline-block;
    margin-bottom: 1.4rem;
    font-family: var(--font-accent);
    font-size: 2.1rem;
    color: var(--color-accent);
  }
  .press-grid h2 {
    font-size: clamp(1.8rem, 2.7vw, 2.45rem);
    margin-bottom: 1rem;
  }
  .source-link {
    display: inline-block;
    margin-top: 1rem;
    color: var(--color-cream);
    font-weight: 700;
    text-decoration: none;
    border-bottom: 1px solid var(--color-accent);
  }
  @media (min-width: 920px) {
    .press-grid { grid-template-columns: repeat(3, 1fr); }
  }
</style>
