---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../content/site';
---
<BaseLayout
  title={`Actividad literaria | ${site.name}`}
  description={`Presentaciones y actividad cultural de ${site.name}.`}
>
  <section class="section">
    <div class="container">
      <p class="eyebrow">Actividad literaria</p>
      <h1>Presentaciones y recorrido público</h1>
      <p class="lead">
        Registro de espacios y actividades vinculadas con Alejandro Roth y su obra.
        Las fuentes externas se añadirán a medida que sean verificadas.
      </p>
      <div class="press-grid">
        {site.press.map((item) => (
          <article class="card">
            <p class="eyebrow">{item.source}</p>
            <h2>{item.title}</h2>
            <p>{item.description}</p>
            {item.url && <a href={item.url}>Ver fuente</a>}
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  h1 { max-width: 15ch; }
  .press-grid {
    display: grid;
    gap: 1rem;
    margin-top: 3rem;
  }
  .press-grid h2 { font-size: 2rem; }
  @media (min-width: 760px) {
    .press-grid { grid-template-columns: repeat(2, 1fr); }
  }
</style>
