---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../content/site';
---
<BaseLayout
  title={`Actividad literaria | ${site.name}`}
  description={`Presentaciones y actividad cultural de ${site.name}.`}
>
  <section class="section activity-page">
    <div class="container activity-inner">
      <p class="eyebrow">Actividad literaria</p>
      <h1>Presentaciones y recorrido público</h1>
      <p class="lead">
        Registro de espacios y actividades vinculadas con Alejandro Roth y su obra.
      </p>
      <div class="press-grid">
        {site.press.map((item) => (
          <article class="card">
            <p class="eyebrow">{item.source}</p>
            <h2>{item.title}</h2>
            <p>{item.description}</p>
            {item.url && <a class="source-link" href={item.url} target="_blank" rel="noopener">Ver fuente →</a>}
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .activity-page { min-height: 72vh; }
  .activity-inner { max-width: 1120px; }
  h1 { max-width: 13ch; }
  .lead { max-width: 55ch; }
  .press-grid {
    display: grid;
    gap: 1.25rem;
    margin-top: 3rem;
  }
  .press-grid h2 {
    font-size: clamp(1.75rem, 2.6vw, 2.35rem);
    margin-bottom: 1rem;
  }
  .source-link {
    display: inline-block;
    margin-top: 1rem;
    color: var(--color-accent);
    font-weight: 700;
    text-decoration: none;
  }
  @media (min-width: 920px) {
    .press-grid { grid-template-columns: repeat(3, 1fr); }
  }
</style>
