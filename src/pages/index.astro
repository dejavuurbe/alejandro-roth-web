---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../content/site';
import { personSchema } from '../core/schema';
const base = import.meta.env.BASE_URL;
---
<BaseLayout
  title={`${site.name} | ${site.role}`}
  description={site.description}
  schema={personSchema()}
>
  <section class="hero section">
    <img class="cover-ghost" src={site.featuredBook.cover} alt="" aria-hidden="true" />
    <div class="water-light water-light-one"></div>
    <div class="water-light water-light-two"></div>

    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Escritor · Buenos Aires</p>
        <h1>{site.name}</h1>
        <p class="lead hero-lead">
          Autor de <span class="book-name">Enigma</span>.
          <span class="cream">Relato de un amor</span>
          <span class="red">incoherente</span>.
        </p>
        <div class="actions">
          <a class="button" href={`${base}obra/`}>Conocer Enigma</a>
          <a class="button secondary" href={`${base}autor/`}>Sobre el autor</a>
        </div>
      </div>

      <div class="portrait-stage">
        <div class="water-ring ring-one"></div>
        <div class="water-ring ring-two"></div>
        <div class="portrait-frame">
          <img
            class="portrait"
            src={site.author.photo}
            alt={`Retrato de ${site.name}`}
            width="700"
            height="820"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="section book-section">
    <div class="container grid-two book-grid">
      <div class="book-visual">
        <div class="book-glow"></div>
        <img
          class="cover"
          src={site.featuredBook.cover}
          alt={`Portada de ${site.featuredBook.title}`}
          width="520"
          height="780"
        />
      </div>
      <div class="book-copy">
        <p class="eyebrow">Obra destacada</p>
        <h2 class="enigma-title">{site.featuredBook.title}</h2>
        <p class="subtitle">
          <span class="subtitle-main">Relato de un amor</span>
          <span class="subtitle-accent">incoherente</span>
        </p>
        <p class="lead">{site.featuredBook.synopsis}</p>
        <div class="book-actions">
          {site.featuredBook.buyUrl && (
            <a
              class="button"
              href={site.featuredBook.buyUrl}
              target="_blank"
              rel="noopener"
            >
              Comprar el libro
            </a>
          )}
          <a class="button secondary" href={`${base}obra/`}>Ver la obra</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section author-strip">
    <div class="container intro">
      <p class="eyebrow">Autor</p>
      <h2>Sobre Alejandro Roth</h2>
      <p class="lead">{site.author.shortBio}</p>
      <a class="text-link" href={`${base}autor/`}>Conocer su trayectoria →</a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    isolation: isolate;
    min-height: calc(100vh - 76px);
    display: grid;
    align-items: center;
    padding-top: clamp(4rem, 7vw, 7rem);
    background:
      linear-gradient(90deg, rgba(3,8,13,.98) 0%, rgba(3,8,13,.91) 42%, rgba(3,8,13,.6) 100%),
      radial-gradient(circle at 78% 43%, rgba(79,169,209,.2), transparent 28rem);
  }

  .cover-ghost {
    position: absolute;
    z-index: -3;
    top: 2%;
    right: -7%;
    width: min(48vw, 660px);
    height: 98%;
    object-fit: cover;
    object-position: center;
    opacity: .13;
    filter: blur(5px) saturate(1.25) contrast(1.08);
    transform: scale(1.06);
    mask-image: linear-gradient(90deg, transparent, #000 35%, #000 88%, transparent);
  }

  .water-light {
    position: absolute;
    z-index: -2;
    border: 1px solid rgba(158,220,243,.32);
    border-radius: 50%;
    filter: blur(.2px);
    opacity: .35;
    pointer-events: none;
  }

  .water-light-one {
    width: 680px;
    height: 240px;
    right: -170px;
    top: 20%;
    transform: rotate(-22deg);
  }

  .water-light-two {
    width: 520px;
    height: 180px;
    right: 7%;
    bottom: 4%;
    transform: rotate(13deg);
    opacity: .18;
  }

  .hero-grid {
    display: grid;
    gap: clamp(3rem, 7vw, 7rem);
    align-items: center;
  }

  .hero-copy { max-width: 720px; }

  .hero-lead {
    margin-top: 1.25rem;
    max-width: 38ch;
    line-height: 1.45;
  }

  .book-name {
    font-family: var(--font-accent);
    font-size: 1.45em;
    color: var(--color-cream);
  }

  .cream { color: var(--color-cream); }
  .red {
    color: var(--color-accent);
    font-family: var(--font-accent);
    font-size: 1.3em;
  }

  .portrait-stage {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 520px;
  }

  .portrait-frame {
    position: relative;
    z-index: 3;
    width: min(100%, 430px);
    aspect-ratio: 4 / 5;
    padding: 9px;
    border: 1px solid rgba(158,220,243,.55);
    border-radius: 42% 42% 48% 48% / 34% 34% 54% 54%;
    background: linear-gradient(145deg, rgba(158,220,243,.15), rgba(255,255,255,.02));
    box-shadow: var(--shadow), var(--water-shadow);
    overflow: hidden;
  }

  .portrait {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: inherit;
    filter: grayscale(1) contrast(1.04);
  }

  .water-ring {
    position: absolute;
    border-radius: 50%;
    border: 1px solid rgba(79,169,209,.5);
    box-shadow: 0 0 40px rgba(79,169,209,.12);
  }

  .ring-one {
    width: 470px;
    height: 260px;
    transform: rotate(-18deg);
  }

  .ring-two {
    width: 510px;
    height: 300px;
    transform: rotate(18deg);
    opacity: .45;
  }

  .actions {
    display: flex;
    gap: .9rem;
    flex-wrap: wrap;
    margin-top: 2.2rem;
  }

  .book-section {
    background:
      radial-gradient(circle at 22% 50%, rgba(79,169,209,.16), transparent 25rem),
      linear-gradient(180deg, #071720, #06131c);
    border-block: 1px solid rgba(79,169,209,.2);
  }

  .book-grid { gap: clamp(4rem, 8vw, 8rem); }

  .book-visual {
    position: relative;
    min-height: 590px;
    display: grid;
    place-items: center;
  }

  .book-glow {
    position: absolute;
    width: 430px;
    height: 430px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(79,169,209,.28), transparent 68%);
    filter: blur(10px);
  }

  .cover {
    position: relative;
    z-index: 2;
    width: min(100%, 370px);
    max-height: 570px;
    object-fit: cover;
    border-radius: 10px;
    box-shadow: 0 28px 70px rgba(0,0,0,.55), 0 0 45px rgba(79,169,209,.12);
    border: 1px solid rgba(158,220,243,.28);
    transform: perspective(1000px) rotateY(4deg) rotateX(1deg);
  }

  .enigma-title {
    font-family: var(--font-accent);
    font-size: clamp(4rem, 7vw, 6.8rem);
    line-height: .9;
    margin-bottom: .7rem;
  }

  .subtitle {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: .45rem;
    margin: 0 0 1.35rem;
    color: var(--color-cream);
  }

  .subtitle-main {
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2.2vw, 1.8rem);
  }

  .subtitle-accent {
    color: var(--color-accent);
    font-family: var(--font-accent);
    font-size: clamp(1.75rem, 2.8vw, 2.35rem);
    font-weight: 600;
    line-height: 1;
    transform: rotate(-2deg);
  }

  .book-actions {
    display: flex;
    gap: .9rem;
    flex-wrap: wrap;
    margin-top: 1.5rem;
  }

  .author-strip {
    background:
      linear-gradient(90deg, rgba(216,52,42,.045), transparent 40%),
      var(--color-bg);
  }

  .intro { max-width: 850px; margin-inline: auto; }
  .text-link {
    display: inline-block;
    margin-top: 1rem;
    color: var(--color-cream);
    font-weight: 700;
    text-decoration: none;
    border-bottom: 1px solid var(--color-accent);
    padding-bottom: .2rem;
  }

  @media (min-width: 900px) {
    .hero-grid { grid-template-columns: 1.15fr .85fr; }
  }

  @media (max-width: 899px) {
    .hero { min-height: auto; }
    .cover-ghost { width: 80vw; opacity: .1; }
    .portrait-stage { min-height: 430px; }
    .portrait-frame { width: min(82vw, 390px); }
    .ring-one { width: 88vw; max-width: 430px; }
    .ring-two { width: 94vw; max-width: 470px; }
    .book-visual { min-height: auto; }
  }
</style>
