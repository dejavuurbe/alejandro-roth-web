---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../content/site';
import { personSchema } from '../core/schema';
---
<BaseLayout
  title={`Sobre ${site.name} | ${site.role}`}
  description={site.author.shortBio}
  schema={personSchema()}
>
  <section class="section author-page">
    <div class="container author-grid">
      <div class="portrait-wrap">
        <div class="water-ring ring-one"></div>
        <div class="water-ring ring-two"></div>
        <img
          src={site.author.photo}
          alt={`Retrato de ${site.name}`}
          width="700"
          height="820"
        />
      </div>
      <article>
        <p class="eyebrow">Autor</p>
        <h1>{site.name}</h1>
        <p class="lead">{site.author.longBio}</p>
        <p class="context">
          Su obra <strong>Enigma. Relato de un amor <span>incoherente</span></strong>
          articula actualmente su presencia pública como autor y sus actividades literarias.
        </p>
      </article>
    </div>
  </section>
</BaseLayout>

<style>
  .author-page {
    min-height: 72vh;
    display: grid;
    align-items: center;
    background:
      radial-gradient(circle at 24% 48%, rgba(79,169,209,.13), transparent 24rem);
  }
  .author-grid {
    display: grid;
    gap: clamp(3rem, 7vw, 7rem);
    align-items: center;
  }
  .portrait-wrap {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 500px;
  }
  img {
    position: relative;
    z-index: 2;
    width: min(100%, 420px);
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 44% 44% 50% 50% / 34% 34% 54% 54%;
    border: 1px solid rgba(158,220,243,.45);
    box-shadow: var(--shadow), var(--water-shadow);
    filter: grayscale(1) contrast(1.04);
  }
  .water-ring {
    position: absolute;
    border-radius: 50%;
    border: 1px solid rgba(79,169,209,.34);
  }
  .ring-one { width: 450px; height: 250px; transform: rotate(-17deg); }
  .ring-two { width: 490px; height: 280px; transform: rotate(17deg); opacity: .45; }
  article { max-width: 680px; }
  .context {
    max-width: 58ch;
    margin-top: 1.5rem;
    color: var(--color-cream);
  }
  .context span {
    color: var(--color-accent);
    font-family: var(--font-accent);
    font-size: 1.35em;
  }
  @media (min-width: 860px) {
    .author-grid { grid-template-columns: .85fr 1.15fr; }
  }
</style>
